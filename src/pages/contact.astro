---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Skirnir Inc.">
  <section>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <h1 class="mt-5 text-start">Contact</h1>
          <p>ご連絡は各種SNSにてお気軽にどうぞ。</p>
          <div style="vertical-align: middle; margin: 0; height: 40px;">
            <ul class="sns_icons">
              <li>
                <a href="https://fb.me/nanasess" target="_blank"><img src="/images/FB.png" alt="Facebook" /></a>
              </li>
              <li>
                <a href="https://twitter.com/nanasess" target="_blank"
                  ><img src="/images/Twitter.png" alt="Twitter" /></a
                >
              </li>
              <li><img src="/images/LINE.png" alt="LINE" /></li>
              <li>
                <a href="https://instagram.com/nanasess" target="_blank"
                  ><img src="/images/Instagram.png" alt="Instagram" /></a
                >
              </li>
              <li>
                <a href="https://github.com/nanasess" target="_blank"
                  ><img src="/images/GitHub.png" alt="GitHub" /></a
                >
              </li>
            </ul>
            @nanasess
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
